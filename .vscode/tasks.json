{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Build the whole solution (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/SchrodingersCat.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "detail": "Run all tests",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/SchrodingersCat.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
