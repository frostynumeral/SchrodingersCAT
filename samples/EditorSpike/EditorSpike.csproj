<Project Sdk="Microsoft.NET.Sdk">

  <!-- Step 3 of docs/design/inline-code-editing.md: a throwaway spike that checks whether AvaloniaEdit can be the
       target editor (chips, atomic codes, IME, screen readers, RTL). Not part of SchrodingersCat.App. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- For TargetEditModel, the model the real editor will sit on. -->
    <ProjectReference Include="..\..\src\SchrodingersCat.App\SchrodingersCat.App.csproj" />
  </ItemGroup>

</Project>
