<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SchrodingersCat.App.ViewModels"
        xmlns:controls="using:SchrodingersCat.App.Controls"
        x:Class="SchrodingersCat.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="700">

    <Window.Styles>
        <!-- Code check badge: the number of issues in the segment, coloured by the worst one. -->
        <Style Selector="Border.issueBadge">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#335B7FC7" />
        </Style>
        <Style Selector="Border.issueBadge.warning">
            <Setter Property="Background" Value="#55FFA000" />
        </Style>
        <Style Selector="Border.issueBadge.error">
            <Setter Property="Background" Value="#E53935" />
        </Style>
        <Style Selector="Border.issueBadge.error TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- The QA report: a dismissed issue greyed, a fixed one struck through, until F8 runs again. -->
        <Style Selector="Grid.qaEntry.dismissed">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Grid.qaEntry.fixed TextBlock.qaMessage">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="Button.dismissIssue">
            <Setter Property="Content" Value="Dismiss" />
        </Style>
        <Style Selector="Grid.qaEntry.dismissed Button.dismissIssue">
            <Setter Property="Content" Value="Restore" />
        </Style>

        <!-- The matches pane: one row per match, its score in a badge, green for an exact (100% or 101%) match. -->
        <Style Selector="Border.matchesPane">
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="4,6,4,0" />
        </Style>
        <Style Selector="Border.match">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#14808080" />
        </Style>
        <Style Selector="Border.matchScore">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="#335B7FC7" />
        </Style>
        <Style Selector="Border.matchScore.exact">
            <Setter Property="Background" Value="#7743A047" />
        </Style>
    </Window.Styles>

    <!-- The segment shortcuts (Ctrl+Enter, Ctrl+Up/Down, Ctrl+Shift+Down, Ctrl+Insert) and Ctrl+1 … Ctrl+9 (insert a match)
         are in MainWindow.axaml.cs. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem x:Name="MemoryMenu" Header="_Translation memory">
                <MenuItem x:Name="NewMemoryItem" Header="_New…" Command="{Binding NewTranslationMemoryCommand}" />
                <MenuItem x:Name="OpenMemoryItem" Header="_Open…" Command="{Binding OpenTranslationMemoryCommand}" />
                <MenuItem x:Name="CloseMemoryItem" Header="_Close" Command="{Binding CloseTranslationMemoryCommand}" />
                <Separator />
                <MenuItem x:Name="ManageEntriesItem" Header="_Manage entries…" Command="{Binding ManageEntriesCommand}" />
                <Separator />
                <MenuItem x:Name="ImportTmxItem" Header="_Import TMX…" Command="{Binding ImportTmxCommand}" />
                <MenuItem x:Name="ExportTmxItem" Header="_Export TMX…" Command="{Binding ExportTmxCommand}" />
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Header="_Help">
                <MenuItem x:Name="OpenLogFolderItem" Header="Open _log folder" Command="{Binding OpenLogFolderCommand}" />
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button x:Name="OpenButton" Content="Open…" Command="{Binding OpenCommand}" />
            <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" />
            <Button x:Name="SaveAsButton" Content="Save as…" Command="{Binding SaveAsCommand}" />
            <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Margin="8,0,8,8" Padding="8" CornerRadius="4"
                Background="#33E53935" BorderBrush="#E53935" BorderThickness="1"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
                <SelectableTextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- The outcome of the last action with no segment to report it in (a segment not stored, an import or export). -->
        <SelectableTextBlock x:Name="NoticeText" DockPanel.Dock="Top" Margin="12,0,12,8" Text="{Binding Notice}" TextWrapping="Wrap"
                             IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Panel>
            <TextBlock Text="Open an XLIFF file to start translating (Ctrl+O)." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" IsVisible="{Binding !Segments.Count}" />

            <DockPanel IsVisible="{Binding !!Segments.Count}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="110,*,*,90" ColumnSpacing="8" Margin="12,0,12,4" Opacity="0.6">
                <TextBlock Grid.Column="0" Text="Unit / segment" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding SourceHeader}" FontWeight="SemiBold" />
                <TextBlock x:Name="TargetHeader" Grid.Column="2" Text="{Binding TargetHeader}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="State" FontWeight="SemiBold" />
            </Grid>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="12,4" Text="{Binding SelectedSegment?.EditStatus}"
                       TextWrapping="Wrap" Foreground="#C75000" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <!-- The pane under the segments: the selected segment's matches (design section 6 of
                 docs/design/translation-memory.md), and the concordance (searching the TM for a word or phrase). -->
            <Border x:Name="MatchesPane" DockPanel.Dock="Bottom" Classes="matchesPane" Margin="8,4,8,0" Height="230">
                <TabControl x:Name="PaneTabs" SelectedIndex="{Binding PaneTab}" Padding="0">
                    <TabItem x:Name="MatchesTab" Header="Matches" FontSize="14">
                        <DockPanel>
                            <TextBlock x:Name="MemoryName" DockPanel.Dock="Top" Margin="4,0,4,4" Text="{Binding MemoryLabel}" Opacity="0.6" TextWrapping="Wrap" />
                            <TextBlock x:Name="MatchesStatus" DockPanel.Dock="Top" Margin="4,0" Opacity="0.6" Text="{Binding MatchesStatus}"
                                       IsVisible="{Binding MatchesStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ScrollViewer>
                                <ItemsControl x:Name="MatchList" ItemsSource="{Binding Matches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatchViewModel">
                                            <Border Classes="match">
                                                <Border.ContextMenu>
                                                    <ContextMenu IsVisible="{Binding Stored, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <MenuItem Header="_Edit entry…" Command="{Binding EditCommand}" CommandParameter="{Binding Stored}" />
                                                        <MenuItem Header="_Delete entry…" Command="{Binding DeleteCommand}" CommandParameter="{Binding Stored}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="64,48,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                    <!-- Not focusable: clicking it leaves the keyboard in the editor. -->
                                                    <Button Grid.RowSpan="2" Classes="insertMatch" Content="{Binding Shortcut}" Command="{Binding InsertCommand}"
                                                            Focusable="False" VerticalAlignment="Top" FontSize="11" ToolTip.Tip="Insert this match into the target" />
                                                    <Border Grid.Column="1" Classes="matchScore" Classes.exact="{Binding IsExact}">
                                                        <TextBlock Text="{Binding Score}" FontSize="11" />
                                                    </Border>
                                                    <controls:InlineContentBlock Grid.Column="2" Classes="matchSource" Runs="{Binding SourceRuns}" TextWrapping="Wrap" />
                                                    <controls:InlineContentBlock Grid.Column="3" Classes="matchTarget" Runs="{Binding TargetRuns}" TextWrapping="Wrap" />
                                                    <!-- Editing and deleting the TM entry (not focusable, like the insert button); none for a file's match. -->
                                                    <DockPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="8,2,0,0"
                                                                    IsVisible="{Binding Stored, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                            <Button Classes="editEntry" Content="Edit" Focusable="False" FontSize="11" Padding="6,1"
                                                                    Command="{Binding EditCommand}" CommandParameter="{Binding Stored}"
                                                                    ToolTip.Tip="Edit this entry's translation in the translation memory" />
                                                            <Button Classes="deleteEntry" Content="Delete" Focusable="False" FontSize="11" Padding="6,1"
                                                                    Command="{Binding DeleteCommand}" CommandParameter="{Binding Stored}"
                                                                    ToolTip.Tip="{Binding DeleteShortcut, StringFormat='Delete this entry from the translation memory ({0})'}" />
                                                        </StackPanel>
                                                        <TextBlock Classes="matchDetails" Text="{Binding Details}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="ConcordanceTab" Header="Concordance" FontSize="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                                <CheckBox x:Name="SearchTargetsBox" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Search translations"
                                          IsChecked="{Binding Concordance.SearchTargets}" />
                                <!-- Enter searches; Escape gives the keyboard back to the editor (MainWindow.axaml.cs). -->
                                <TextBox x:Name="ConcordanceBox" Text="{Binding Concordance.Query}"
                                         PlaceholderText="A word or phrase (Ctrl+K searches the selected text)">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding Concordance.SearchCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </DockPanel>
                            <TextBlock x:Name="ConcordanceStatus" DockPanel.Dock="Top" Margin="4,0" Opacity="0.6" Text="{Binding Concordance.Status}"
                                       IsVisible="{Binding Concordance.Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ScrollViewer>
                                <ItemsControl x:Name="ConcordanceList" ItemsSource="{Binding Concordance.Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConcordanceResultViewModel">
                                            <Border Classes="match">
                                                <Border.ContextMenu>
                                                    <ContextMenu IsVisible="{Binding Stored, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <MenuItem Header="_Edit entry…" Command="{Binding EditCommand}" CommandParameter="{Binding Stored}" />
                                                        <MenuItem Header="_Delete entry…" Command="{Binding DeleteCommand}" CommandParameter="{Binding Stored}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="64,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                    <!-- Not focusable: clicking it leaves the keyboard in the editor. -->
                                                    <Button Grid.RowSpan="2" Classes="insertResult" Content="Insert" Focusable="False" VerticalAlignment="Top" FontSize="11"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Concordance.InsertCommand, FallbackValue={x:Null}}"
                                                            CommandParameter="{Binding}" ToolTip.Tip="Insert this translation at the caret, as text" />
                                                    <controls:InlineContentBlock Grid.Column="1" Classes="resultSource" Runs="{Binding SourceRuns}" TextWrapping="Wrap" />
                                                    <controls:InlineContentBlock Grid.Column="2" Classes="resultTarget" Runs="{Binding TargetRuns}" TextWrapping="Wrap" />
                                                    <!-- Editing and deleting the TM entry (not focusable, like the insert button); none for a file's match. -->
                                                    <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="8,2,0,0"
                                                                    IsVisible="{Binding Stored, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                            <Button Classes="editEntry" Content="Edit" Focusable="False" FontSize="11" Padding="6,1"
                                                                    Command="{Binding EditCommand}" CommandParameter="{Binding Stored}"
                                                                    ToolTip.Tip="Edit this entry's translation in the translation memory" />
                                                            <Button Classes="deleteEntry" Content="Delete" Focusable="False" FontSize="11" Padding="6,1"
                                                                    Command="{Binding DeleteCommand}" CommandParameter="{Binding Stored}"
                                                                    ToolTip.Tip="Delete this entry from the translation memory" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <!-- The document's quality report (F8; step 4 of docs/design/qa-checks.md). Clicking an entry or
                         Enter opens its segment (MainWindow.axaml.cs); the list stays until F8 runs again. -->
                    <TabItem x:Name="QaTab" Header="QA" FontSize="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                    <Button x:Name="RunQaButton" Content="Check document (F8)" Command="{Binding Qa.RunCommand}" Focusable="False" FontSize="12" />
                                    <Button x:Name="QaSettingsButton" Content="Settings…" Command="{Binding Qa.SettingsCommand}" FontSize="12" />
                                </StackPanel>
                                <TextBlock x:Name="QaStatus" Text="{Binding Qa.Status}" Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <ListBox x:Name="QaList" ItemsSource="{Binding Qa.Rows}">
                                <ListBox.DataTemplates>
                                    <DataTemplate x:DataType="vm:QaReportHeader">
                                        <TextBlock Classes="qaHeader" Text="{Binding Text}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
                                    </DataTemplate>
                                    <DataTemplate x:DataType="vm:QaReportEntry">
                                        <Grid Classes="qaEntry" Classes.dismissed="{Binding IsDismissed}" Classes.fixed="{Binding IsFixed}"
                                              ColumnDefinitions="70,110,*,Auto" ColumnSpacing="8">
                                            <Border Classes="issueBadge" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Severity}" FontSize="11" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Segment.Label}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Classes="qaMessage" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                            <!-- Not focusable, so clicking it doesn't take the keyboard from the list. -->
                                            <Button Grid.Column="3" Classes="dismissIssue" Focusable="False" FontSize="11" Padding="6,1"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Qa.ToggleDismissedCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}" IsVisible="{Binding CanDismiss}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
            <ListBox x:Name="SegmentList" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SegmentViewModel">
                        <Grid ColumnDefinitions="110,*,*,90" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.6" TextWrapping="Wrap" />
                            <!-- Clicking a source chip inserts the code at the target's caret (active row only). -->
                            <controls:InlineContentBlock Grid.Column="1" Classes="source" Runs="{Binding SourceRuns}" TextWrapping="Wrap"
                                                         ChipCommand="{Binding InsertCodeCommand}" ClipboardUnit="{Binding Unit}" />
                            <Border Grid.Column="2" Classes="targetFrame" Classes.editing="{Binding IsActive}">
                                <Panel>
                                    <controls:TargetEditor Classes="target" Model="{Binding ActiveEditModel}" Status="{Binding EditStatus}"
                                                           ProblemCodes="{Binding TargetProblemCodes}" IsVisible="{Binding IsActive}" />
                                    <controls:InlineContentBlock Classes="target" Runs="{Binding TargetRuns}" TextWrapping="Wrap"
                                                                 IsVisible="{Binding !IsActive}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Text="{Binding State}" Opacity="0.6" />
                                <Border Classes="issueBadge" Classes.warning="{Binding HasWarnings}" Classes.error="{Binding HasErrors}"
                                        IsVisible="{Binding HasIssues}" ToolTip.Tip="{Binding IssueSummary}">
                                    <!-- Right-click dismisses a quality issue (code issues can't be dismissed). -->
                                    <Border.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding Issues}">
                                            <ContextMenu.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SegmentIssue">
                                                    <TextBlock Text="{Binding Message, StringFormat='Dismiss: {0}'}" />
                                                </DataTemplate>
                                            </ContextMenu.ItemTemplate>
                                            <ContextMenu.Styles>
                                                <Style Selector="MenuItem" x:DataType="vm:SegmentIssue">
                                                    <Setter Property="Command" Value="{Binding $parent[ContextMenu].((vm:SegmentViewModel)DataContext).DismissCommand, FallbackValue={x:Null}}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                </Style>
                                            </ContextMenu.Styles>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Text="{Binding Issues.Count}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
        </Panel>
    </DockPanel>
</Window>
