<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SchrodingersCat.App.Views.ConfirmDialog"
        SizeToContent="WidthAndHeight" CanResize="False" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="16" MaxWidth="420">
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton" Classes="accent" IsDefault="True" Click="OnConfirm" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
