<!-- How content looks wherever it's shown (the grid, the matches pane, the entry editor): code chips, annotation
     halves, and the frame around a target. Included by App.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Code chips (design section 1). The shape shows pairing: an opening half points right, a closing half left. -->
    <Style Selector="Border.chip">
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Background" Value="#335B7FC7" />
        <Setter Property="BorderBrush" Value="#5B7FC7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.chip.opening">
        <Setter Property="CornerRadius" Value="2,8,8,2" />
    </Style>
    <Style Selector="Border.chip.closing">
        <Setter Property="CornerRadius" Value="8,2,2,8" />
    </Style>
    <Style Selector="Border.chip.protected">
        <Setter Property="BorderBrush" Value="DarkOrange" />
    </Style>
    <!-- A code the code check reports a problem with (design section 3). -->
    <Style Selector="Border.chip.problem">
        <Setter Property="BorderBrush" Value="#E53935" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.chip TextBlock">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- In a match's source: codes the current source lacks, or has in addition (design section 6 of
         docs/design/translation-memory.md). Text is styled in InlineContentBlock. -->
    <Style Selector="Border.chip.removed">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="BorderBrush" Value="#E53935" />
    </Style>
    <Style Selector="Border.chip.added">
        <Setter Property="Background" Value="#5543A047" />
        <Setter Property="BorderBrush" Value="#43A047" />
    </Style>

    <!-- Annotation halves in the editor: very small brackets (design section 1). -->
    <Style Selector="Border.marker">
        <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style Selector="Border.marker TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Targets: the active segment's in the editor, the others as read-only chips in the same frame. -->
    <Style Selector="Border.targetFrame">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#40808080" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Border.targetFrame.editing">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="9,5" />
    </Style>
</Styles>
