root = true

[*]
# LF everywhere, so dotnet format gives the same result on every platform (see .gitattributes).
end_of_line = lf
charset = utf-8

[*.cs]
indent_style = space
indent_size = 4

[tests/**.cs]
# xUnit test names use Method_Scenario underscores by convention.
dotnet_diagnostic.CA1707.severity = none
